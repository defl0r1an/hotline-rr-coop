// The partner's body on this PC: drawn from PSTATE messages only, never reads input. Deliberately NOT a child
// of objPlayer, so the game's objPlayer.x / with (objPlayer) / instance_exists(objPlayer) code ignores it.
image_speed = 0;
stale = 0;
p_kind = 0;
p_obj = -1;
t_x = x;
t_y = y;
p_ang = 0;
p_left = 1;
p_legspr = -1;
p_legimg = 0;
p_legdir = 0;
p_mask = 0;
p_maskon = 0;
p_thr = 0;
p_light = 0;
last_sprite = -1;
coop_hit_cd = 0;  // host: frames until enemies may melee-kill the partner again (scrCoopMeleePuppet)
var coop_k;
for (coop_k = 0; coop_k < 64; coop_k += 1)
{
    maskaddx[coop_k] = 0;
    maskaddy[coop_k] = 0;
}
scrInitThrowPos();
// Variables the game's melee scripts read on the attacker; the host runs copies of them as this puppet
// (scrCoopPuppetAttack / scrCoopPuppetPunch, generated by coop/patch/gen_puppet_melee.py).
dir = 0;
left = 1;
lastx = x;
lasty = y;
ammo = 0;
angle = 0;
count = 0;
edir = 0;
hits = 0;
i = 0;
my_id = noone;
my_id1 = noone;
my_id2 = noone;
my_x = x;
my_y = y;
noweapon = 0;
part = 0;
sparks = 0;
reload = 0;
type = 0;
text = "";
nothing = 0;
life = 0;
dead = 0;
bottom = 0;
decadenced = 0;
start_x = x;
start_y = y;
start_x_static = x;
start_y_static = y;
CompleteAchievements = 0;
test = 0;
tempid = noone;
// Player fields special enemies read through global.coop_tinst (ai_retarget_special.txt).
addx = 0;
addy = 0;
legindex = 0;
myxspeed = 0;
myyspeed = 0;
prevsprite = -1;
active = 1;
aimfar = 0;
maskindex = 0;
