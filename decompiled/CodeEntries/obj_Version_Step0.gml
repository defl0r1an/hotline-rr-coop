draw_text(x, y - 1, "YOUR GAME IS#29.10.0#THANK YOU FOR PLAYING!");
draw_set_color(c_white);
draw_text(x, y, "YOUR GAME IS#29.10.0#THANK YOU FOR PLAYING!");
