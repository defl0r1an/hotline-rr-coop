global.showlist = ds_list_create();
for (i = 0; ds_list_find_value(global.bonuslist, "2x Combo"); i += 1)
{
    ds_list_delete(id, ds_list_find_value(global.bonuslist, "2x Combo"));
}
if (i > 0)
{
    ds_list_add(global.showlist, "2x Combo x" + string(i));
}
