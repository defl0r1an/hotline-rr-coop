if (global.language == 0)
{
    if (global.dialoguestyle == 0)
    {
        dialoguefont = 6;
    }
    else
    {
        dialoguefont = 7;
    }
    scorefont = 6;
    scoreupdatefont = 7;
    restartfont = 12;
}
if (global.language == 1)
{
    if (global.dialoguestyle == 0)
    {
        dialoguefont = 6;
    }
    else
    {
        dialoguefont = 8;
    }
    scorefont = 6;
    scoreupdatefont = 8;
    restartfont = 12;
}
